# ============================================
# SQL Server
# ============================================
SA_PASSWORD=YourStrong@Password123
MSSQL_PID=Developer
SQLSERVER_PORT=1433

# ============================================
# API
# ============================================
ASPNETCORE_ENVIRONMENT=Development
DB_CONNECTION_STRING=Server=sqlserver;Database=ProductManagementDB;User Id=sa;Password=YourStrong@Password123;TrustServerCertificate=True;MultipleActiveResultSets=true
API_HTTP_PORT=5000
API_HTTPS_PORT=5001

# ============================================
# RabbitMQ
# ============================================
RABBITMQ_HOSTNAME=rabbitmq
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# ============================================
# Nginx
# ============================================
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# ============================================
# Redis
# ============================================
REDIS_CONNECTION_STRING=redis:6379

# ============================================
# JWT
# ============================================
JWT_SECRET_KEY=YourSuperSecretKeyThatIsAtLeast32CharactersLongForHS256Algorithm!
JWT_ISSUER=ProductManagementAPI
JWT_AUDIENCE=ProductManagementClient

# ============================================
# Docker Registry
# ============================================
DOCKER_REGISTRY=ghcr.io/max2535/
IMAGE_TAG=latest

# ============================================
# Email (Optional)
# ============================================
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password